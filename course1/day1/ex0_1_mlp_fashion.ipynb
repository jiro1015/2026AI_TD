   "source": [
    "# 入力の数 = チャネル × 高さ × 幅（画像を 1 列に並べたときの長さ）\n",
    "INPUT_SIZE = c * h * w\n",
    "# 中間層（隠れ層）のニューロンの数\n",
    "HIDDEN_SIZE1 = 512\n",
    "HIDDEN_SIZE2 = 256\n",
    "# 出力の数 = 分類するクラスの数\n",
    "OUTPUT_SIZE = 10\n",
    "\n",
    "# 層を上から順に積み重ねてモデルを作る\n",
    "model = nn.Sequential(\n",
    "    # 画像（または特徴マップ）を 1 列のベクトルに伸ばす\n",
    "    nn.Flatten(),\n",
    "    # 全結合層：すべての入力とつながる\n",
    "    nn.Linear(INPUT_SIZE, HIDDEN_SIZE1),\n",
    "    # 活性化関数：負の値を 0 にする\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(HIDDEN_SIZE1, HIDDEN_SIZE2),\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(HIDDEN_SIZE2, OUTPUT_SIZE)\n",
    ")\n",
    "# モデルを計算装置に載せる\n",
    "model.to(device)\n",
    "\n",
    "model"
   ]
