    "train_val_dataset = datasets.FashionMNIST(\n",
    "    root=str(ROOT / 'assets' / 'data'), \n",
    "    train=True, \n",
    "    download=True, \n",
    "    transform=data_transform\n",
    ")\n",
    "# テスト用データ（1 万枚．学習には使わない）を読み込む\n",
